# =============================================================================
# Creality Filament System (CFS): printer.cfg configuration example
# =============================================================================
#
# Protocol: CFS RS485 v1. Hardware-validated on the Creality Hi and the
#           K1 Max (stock CFS firmware 2.3.5.34).
#
#           Two different filament systems ship under the CFS name and only
#           the first is this protocol:
#
#             CFS over RS485    Hi, K1, K1C, K1 SE, K1 Max     <- this repo
#             CFS-C over CAN    K2 / X2000E line               <- not supported
#
#           The K1 family is RS485, not CAN: the same protocol as the Hi. On a
#           K1 Max the operational opcodes 0x02, 0x03, 0x04, 0x05, 0x08, 0x0A,
#           0x0B, 0x0D, 0x0F, 0x10, 0x11 and 0x14 are confirmed on the wire.
#           An earlier revision of this file said the K1 family was a CAN
#           build; that applies to CFS-C, not to the K1 family.
#
#           Hardware-tested: Hi, K1 Max. The K1 / K1C values further down come
#           from Creality's box.cfg and are untested.
# Baud rate: 230400 (validated by captured traffic; do not change)
# CRC: CRC-8/SMBUS (poly=0x07, init=0x00) validated against 16/16 vectors
#
# Two-step install:
#   1. Copy creality_cfs.py to ~/klipper/klippy/extras/creality_cfs.py
#   2. Add the [creality_cfs] block below to your printer.cfg
#
# Then restart Klipper and verify the module loaded:
#   grep creality_cfs /var/log/klipper/klippy.log
# Expected: "creality_cfs: module loaded, port=... baud=230400"
#
# First-boot test:
#   CFS_INIT           -- run auto-addressing (discover all boxes)
#   CFS_VERSION        -- print firmware version from each box
#   CFS_STATUS         -- print operating state of each box
#
# Full installation guide with wiring diagrams: see INSTALL.md
# =============================================================================


# -----------------------------------------------------------------------------
# Choose ONE of the [creality_cfs] blocks below depending on your setup.
# -----------------------------------------------------------------------------


# ---- Option A: Creality printer onboard RS485 (Hi) -------------------------
# Use this on Creality printers where the CFS connects to the printer's
# mainboard RS485 port (typically UART5 = /dev/ttyS5). The K1 family reaches
# the CFS over a CH340 USB adapter instead: see the K1 section below.

[creality_cfs]
serial_port: /dev/ttyS5
#   RS485 serial port connected to the CFS hub.
#   Validated: Creality Hi (UART5). Other Allwinner-based hosts may expose the
#   same node; on a non-Creality host use Option B (USB-RS485) below.

baud: 230400
#   Serial baud rate. Validated by captured traffic. Do not change.

timeout: 0.1
#   Default command timeout in seconds for short query commands.
#   The choreography commands manage their own (much longer) per-stage timeouts:
#   the box HOLDS 0x10/0x11 replies until each mechanical step finishes.

retry_count: 3
#   Retry attempts for failed (no-response or CRC-error) query commands.
#   Choreography stage frames are always single-shot (stock behavior).

box_count: 1
#   Number of CFS CONTROLLERS (1-4) in the daisy chain -- NOT tool slots.
#   One CFS = one controller with four slots = box_count: 1 (the normal case).
#   Only a physically chained second unit raises this.

auto_init: True
#   Run CFS_INIT automatically on klippy:ready.
#   Set False if you want to control timing manually.

filament_sensor: filament_sensor
#   Name of the TOOLHEAD [filament_switch_sensor <name>] section. This switch
#   gates the load (feed until it trips) and the unload (done when it clears).
#   STRONGLY recommended -- without one, loads run a single ungated cycle and
#   cannot confirm the filament arrived.

extrude_temp: 220
#   Default melt temperature for loads/unloads/flushes/cuts. Every filament
#   move blocks on M109 to this first (>= 170C floor). Override per-material
#   with TEMP= on CFS_EXTRUDE/CFS_RETRUDE/CFS_FLUSH/CFS_CUT.

#load_max_bursts: 5
#   Per-arm 0x05 push cap during a load (the box self-limits to ~3 real pushes
#   per arm; the loop re-arms automatically).

#load_wall_budget: 90
#   Wall-clock ceiling (s) for the whole sensor-gated load.

# ---- Optional: filament cutter (needed for CFS_CUT) -------------------------
#cut_switch_pin: !toolhead_mcu:PB1
#   The cutter microswitch/hall pin. CFS_CUT REFUSES to run without this (a
#   blind ram with no switch could crash the toolhead). The pin itself is only
#   a config guard here; wire it to a [gcode_button] if you want to read it.
#pre_cut_pos_x: 240
#pre_cut_pos_y: 130
#cut_pos_x: 283.5
#cut_pos_x_max: 285
#cut_velocity: 3000

# ---- Optional: flush tuning --------------------------------------------------
#nozzle_volume: 108
#   Melt-zone volume (mm^3); flush base length = nozzle_volume / 2.4. Default 108
#   matches the stock CFS compiled default; raise it (e.g. 183) for a longer purge base.
#buffer_empty_len: 30
#   Filament-buffer capacity in mm (stock default 30, bounds 0-60). The flush clog
#   watchdog arms only for purge cycles of at least 2x this length; shorter moves can
#   be absorbed by the buffer spring without turning the measuring wheel.
#nozzle_clean_macro: WIPE_NOZZLE
#   A [gcode_macro] run once per flush cycle (your wipe routine).
#flush_cycle_cap: 80
#flush_default_len: 140
#flush_velocity: 360

# ---- Optional: K1-family stock parity and idle behaviour ---------------------
# Every option below defaults to the Hi-validated behaviour. The K1 Max values
# are in configs/cfs_k1max.cfg.
#load_finalize: True
#   Send the 0x10 [slot][07][03] finalize after the load settle stage. The K1 Max
#   stock host never sends it (K1 Max: False).
#release_feeder_after_load: True
#   Release the feeder motor (0x0F 00) at the end of each load. The K1 Max stock
#   host keeps it engaged for the whole print, driven by CFS_FEEDER (K1 Max: False).
#retrude_pull_len: 15
#retrude_pull_velocity: 360
#   The single toolhead pull (mm, mm/min) between the unload START and FINISH
#   frames (K1 Max stock Tn_retrude: 20).
#cut_switch_button: cfs_cut_switch
#   A [gcode_button] on the cutter switch. When set, CFS_CUT checks that it reads
#   PRESSED at the cut position and raises a recoverable error if it does not.
#heartbeat_interval: 0
#   Seconds between idle GET_BOX_STATE (0x0A) polls of every online box; 0 = off.
#   The poll skips a tick while a load, unload, cut or flush runs. After 3 silent
#   polls the boxes are re-addressed, but not while a print runs or is paused.
#   Without it the K1 Max front LEDs blink red (K1 Max: 4).
#idle_presence_poll: True
#   Read slot presence (0x08) on every heartbeat. The stock K1 Max sends none
#   while idle and follows the box's 0x30 insert pushes (K1 Max: False).
#k1max_connect: False
#   Send the stock K1 Max connect burst (0x04 [00 01], 0x14, 0x0D [0f 01],
#   0x08 [00]) instead of the Hi burst. With the Hi burst, spool inserts stop
#   working on a K1 Max (K1 Max: True).
#loader_wake: False
#   After a cold boot the box answers discovery from its loader. Send 0x0B
#   LOADER_TO_APP and address it again (K1 Max: True).
#detect_path_on_connect: False
#   At connect, read the path sensor (0x08 ch 0x01) and adopt the slot found
#   there as the loaded tool, so a restart does not forget it. Not wire-confirmed
#   on the Hi (K1 Max: True).
#buffer_recheck_s: 0
#   When the buffer (0x05) is not at middle right after a load, read it again
#   after this many seconds and log it, instead of reporting it at once; 0 = off
#   (K1 Max: 7).
#box_sensor: cfs_box
#   Publish box 1's temperature and humidity as [temperature_sensor <name>].
#box_env: False
#   Decode the box temperature (b0, deg C) and humidity (b1, %RH) from the 0x0A
#   reply. Confirmed on the K1 Max; defaults to True when box_sensor is set.
#afc_compat: False
#   Publish the slots to Fluidd's AFC panel and keep per-slot filament data
#   (material, colour, tool map, runout slot). Required by cfs_k1max.cfg.
#lane_data_file: <printer.cfg directory>/cfs_lanes.json
#afc_extruder: extruder


# ---- Option B: USB-RS485 adapter (non-Creality printer or USB host) --------
# Comment out Option A above and uncomment this block to use a USB-RS485
# dongle (CH341 confirmed; FTDI also works). Recommended for Raspberry Pi,
# Jetson, BTT CB1/CB2 hosts, or anyone running mainline Klipper.
#
# Find your adapter's stable path with:  ls /dev/serial/by-id/
#
# [creality_cfs]
# serial_port: /dev/serial/by-id/usb-1a86_USB_Single_Serial_*-if00
# baud: 230400
# box_count: 1
# auto_init: True


# ---- Creality K1 / K1C / K1 Max (stock RS485 CFS) --------------------------
# The K1 family reaches its CFS over a CH340, so this is Option B with the
# node Creality's own firmware uses. Note it is USB_Serial, NOT the
# USB_Single_Serial path above: those are different adapters and the glob
# above will not match a stock K1.
#
# Confirm yours first:  ls /dev/serial/by-id/
#
# K1 Max: do not copy blocks from this file. Include configs/cfs_k1max.cfg
# instead (it holds the full [creality_cfs] block, both switches and the
# tool-change macros), and do not also include cfs_macros.cfg: both define
# T0-T3. See INSTALL.md, "K1 Max install".
#
# [creality_cfs]
# serial_port: /dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
# baud: 230400
# box_count: 1
# auto_init: True
# filament_sensor: filament_sensor_2
#
# Both switches are on the nozzle MCU. K1 Max wiring (hardware-tested):
#
# [filament_switch_sensor filament_sensor_2]     # toolhead filament switch
# switch_pin: ^!nozzle_mcu:PA10
#
#   cut_switch_pin: nozzle_mcu:PA8               # cutter switch, in [creality_cfs]
#
# An earlier revision of this file put filament_sensor_2 on PA8; PA8 is the
# cutter switch. K1 / K1C wiring has not been checked.
#
# Cut, clean and extrude geometry differs from the Hi. Stock values, from
# Creality's own box.cfg for each model:
#
#                        K1        K1C       K1 Max
#   pre_cut_pos_x/y      42.0 / 160.0        38 / 230
#   cut_pos_y            223.3     227.5     306 (Y ram)
#   cut_velocity         8000                7000
#   clean_left_x         153.5               -
#   clean_right_x        178.0               -
#   extrude_pos x/y/z    148 / 225.3 / 30.0  185 / 305.5 / 30
#
# K1 Max: do NOT set cut_pos_x. The stock box.cfg lists 38, the same as
# pre_cut_pos_x, and CFS_CUT refuses a zero-travel X ram; with cut_pos_x unset
# it rams along Y to cut_pos_y. [stepper_y] position_max must be >= 306 (stock
# 307.5). The purge chute (extrude_pos) and safe Y 291.5 live in the
# _CFS_SETTINGS macro of cfs_k1max.cfg, not in [creality_cfs].
#
# Only the K1 Max is hardware-tested. The K1 / K1C columns are Creality's
# box.cfg values and are untested; run tools/capture_cfs_traffic.py against
# the port above before letting them drive a machine.


# ---- If your machine is a K2 / X2000E, stop -------------------------------
# Those use CFS-C: the same 0xF7 packet, but over SocketCAN at 1 Mbit, with
# the cutter as its own addressable CAN node. This module speaks RS485 only
# and will not reach a CFS-C box. Installing it there is not dangerous, it
# simply cannot work.


# -----------------------------------------------------------------------------
# Optional: Include CFS macros (T0/T1/T2/T3, CFS_PRINT_START, etc.)
# -----------------------------------------------------------------------------
# Add this line anywhere in printer.cfg to load the bundled macros:
#
#   [include cfs_macros.cfg]
#
# Place cfs_macros.cfg in the same directory as printer.cfg. cfs_macros.cfg is
# the Hi macro set; on a K1 Max use [include cfs_k1max.cfg] instead.
#
# Mainline Klipper: the macros use RESPOND, which needs a [respond] section.
# cfs_k1max.cfg contains one; cfs_macros.cfg does not, so with it add:
#
#   [respond]
#
# Without it every RESPOND fails with Unknown command:"RESPOND", and the
# CFS_MENU dialog and the cut-switch messages show nothing. Kalico loads
# respond on its own.


# -----------------------------------------------------------------------------
# Optional: Buffer-empty filament-runout sensor
# -----------------------------------------------------------------------------
# The CFS exposes a mechanical switch on connector pin 2 that closes when
# the buffer tube runs empty. Wire it to a pulled-up GPIO and uncomment:
#
# [filament_switch_sensor cfs_buffer]
# switch_pin: ^EBB:PA2     # replace with your actual GPIO pin
# pause_on_runout: false   # set True if you want auto-pause on empty
# runout_gcode:
#     RESPOND MSG="CFS buffer empty, load filament or pause"
