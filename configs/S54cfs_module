#!/bin/sh
# Keep the Creality CFS Klipper modules linked into Klipper. The real files live with the
# printer config (backed up with it); a SimpleAF/Klipper update can remove the links, so they
# are recreated on every boot before Klipper starts (S55klipper_service).
SRC_DIR=/usr/data/printer_data/config/cfs
DST_DIR=/usr/data/klipper/klippy/extras

case "$1" in
  start|restart|reload|"")
    for name in creality_cfs.py abortable_waits.py; do
      SRC=$SRC_DIR/$name
      DST=$DST_DIR/$name
      if [ -f "$SRC" ] && [ "$(readlink "$DST" 2>/dev/null)" != "$SRC" ]; then
        rm -f "$DST"
        ln -s "$SRC" "$DST"
        echo "cfs: linked $DST -> $SRC"
      fi
    done
    ;;
  stop) ;;
  *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
